# ---------- Shared ----------
NODE_ENV=development
PORT=3003
MONGO_URI=mongodb://localhost:27017/freshroot_order
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# ---------- JWT (chỉ verify, phải TRÙNG với auth-service) ----------
JWT_ACCESS_SECRET=

# ---------- CORS ----------
ADMIN_APP_URL=http://localhost:3000

# ---------- Inter-service ----------
# Docker: http://product-service:3002
PRODUCT_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_TIMEOUT_MS=5000
