# ---------- Shared (backend-architecture.md mục 6.2) ----------
NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/freshroot_auth
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# ---------- JWT (auth-service.md mục 3, 8) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------- Admin Web & Reset Password (auth-service.md mục 5.5, 8) ----------
ADMIN_APP_URL=http://localhost:3000
RESET_PASSWORD_TOKEN_EXPIRY_MINUTES=15

# ---------- SMTP / Nodemailer (auth-service.md mục 8) — optional, chỉ cần cho forgot-password ----------
SMTP_HOST=enter_your_smtp_host_here
SMTP_PORT=enter_your_smtp_port_here
SMTP_USER=enter_your_smtp_user_here
SMTP_PASS=enter_your_smtp_pass_here

# ---------- Seed Admin đầu tiên (auth-service.md mục 1.1, 8) ----------
# Chỉ dùng bởi `npm run seed:admin`, có thể xoá khỏi .env sau khi seed xong
SEED_ADMIN_USERNAME=enter_your_seed_admin_username_here
SEED_ADMIN_PASSWORD=enter_your_seed_admin_password_here
